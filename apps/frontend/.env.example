VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# Sur Vercel, déclarer ces variables dans les "Environment Variables" du projet.
# Les secrets Vercel doivent porter les noms : buildflow_supabase_url et buildflow_supabase_anon_key.
# Commande Vercel CLI pour les créer :
#   vercel env add VITE_SUPABASE_URL production
#   vercel env add VITE_SUPABASE_ANON_KEY production
