{
  "name": "buildflow-monorepo",
  "private": true,
  "scripts": {
    "dev:frontend": "npm --prefix ./apps/frontend run dev",
    "build:frontend": "npm --prefix ./apps/frontend run build",
    "preview:frontend": "npm --prefix ./apps/frontend run preview -- --host 127.0.0.1 --port 4173 --strictPort",
    "preview:frontend:4174": "npm --prefix ./apps/frontend run preview -- --host 127.0.0.1 --port 4174 --strictPort",
    "check:bundle:frontend": "npm --prefix ./apps/frontend run check:bundle",
    "build:backend": "npm --prefix ./apps/backend run build",
    "test:unit": "cd apps/frontend && npx jest --coverage",
    "test:e2e": "cd apps/frontend && npx playwright test",
    "audit": "npm audit --omit=dev",
    "ci": "npm run audit && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "babel-jest": "^30.3.0"
  },
  "dependencies": {
    "@sentry/react": "^10.54.0",
    "@sentry/tracing": "^7.120.4",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^3.5.0"
  }
}
